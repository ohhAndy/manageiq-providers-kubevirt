{
  "apiVersion": "v1",
  "kind": "Template",
  "metadata": {
    "annotations": {
      "description": "OCP kubevirt linux, template",
      "tags": "kubevirt,ocp,template,linux"
    },
    "clusterName": "",
    "creationTimestamp": "2018-01-24T10:15:25Z",
    "labels": {
      "miq.github.io/kubevirt-is-vm-template": "true",
      "kubevirt.io/os": "rhel-7"
    },
    "name": "example",
    "namespace": "default",
    "resourceVersion": "262502",
    "selfLink": "/apis/kubevirt.io/v1alpha3/namespaces/default/templates/test",
    "uid": "7e6fb1ac-00ef-11e8-8840-525400b2cba8"
  },
  "objects": [
    {
      "apiVersion": "kubevirt.io/v1alpha3",
      "kind": "VirtualMachine",
      "metadata": {
        "name": "${NAME}"
      },
      "spec": {
        "dataVolumeTemplates": [
          {
            "metadata": {
              "name": "${NAME}"
            },
            "spec": {
              "storage": {
                "resources": {
                  "requests": {
                    "storage": "30Gi"
                  }
                }
              }
            }
          }
        ],
        "template": {
          "spec": {
            "domain": {
              "cpu": {
                "cores": "4"
              },
              "devices": {
                "disks": [
                  {
                    "bootOrder": 1,
                    "disk": {
                      "bus": "virtio"
                    },
                    "name": "rootdisk"
                  },
                  {
                    "disk": {
                      "bus": "virtio"
                    },
                    "name": "cloudinitdisk"
                  }
                ]
              },
              "machine": {
                "type": "q35"
              },
              "memory": {
                "guest": "4096Mi"
              }
            },
            "volumes": [
              {
                "name": "rootdisk",
                "dataVolume": {
                  "name": "${NAME}"
                }
              },
              {
                "name": "cloudinitdisk",
                "cloudInitNoCloud": {
                  "userData": "#cloud-config\npassword: atomic\n"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "linux-vm-pvc-${NAME}"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "NAME",
      "description": "Name for the new VM"
    },
    {
      "name": "MEMORY",
      "description": "Amount of memory in MB",
      "value": "4096Mi"
    },
    {
      "name": "CPU_CORES",
      "description": "Amount of cores",
      "value": "4"
    }
  ]
}
