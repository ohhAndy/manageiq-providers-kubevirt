{
  "apiVersion": "kubevirt.io/v1",
  "kind": "VirtualMachine",
  "metadata": {
    "name": "demo-vm",
    "namespace": "default",
    "uid": "9f3a8f56-1bc8-11e8-a746-001a4a23138b",
    "labels": {
      "kubevirt.io/os": "rhel-7"
    },
    "annotations": {
      "tags": "linux"
    }
  },
  "spec": {
    "template": {
      "spec": {
        "domain": {
          "cpu": {
            "cores": 2,
            "sockets": 1,
            "threads": 1
          },
          "resources": {
            "requests": {
              "memory": "1Gi"
            }
          },
          "devices": {
            "disks": [
              {
                "name": "rootdisk",
                "bootOrder": 1,
                "disk": {
                  "bus": "virtio"
                }
              }
            ]
          }
        },
        "volumes": [
          {
            "name": "rootdisk",
            "persistentVolumeClaim": {
              "claimName": "demo-vm-rootdisk"
            }
          }
        ]
      }
    }
  }
}
